# Copy to .env (or .env.local) to change. Both settings are read at BUILD time by Next.js.

# Where the API is. Default /api: the same origin that serves this site.
# Never put localhost or a cloud URL in the code; set it here if you need another address.
NEXT_PUBLIC_API_BASE_URL=/api

# true = use the example responses in src/mocks/ (no API needed). false = call the API.
NEXT_PUBLIC_USE_MOCKS=true

# true = build the developer page (/developer) and its call log, for the team. Leave it out
# of any public build: Docker and CI don't set it, so it is off there.
NEXT_PUBLIC_DEV_TOOLS=true

# Development only (npm run dev, npm run preview), not part of the build: forward /api to a
# locally running API, e.g. http://127.0.0.1:8000. Leave empty when using mocks.
DEV_API_PROXY=

# Next.js sends anonymous build usage data to Vercel unless this is set (no visitor data).
NEXT_TELEMETRY_DISABLED=1

# Copy to .env (or .env.local) to change. Both settings are read at BUILD time by Vite.

# Where the API is. Default /api: the same origin that serves this site.
# Never put localhost or a cloud URL in the code; set it here if you need another address.
VITE_API_BASE_URL=/api

# true = use the example responses in src/mocks/ (no API needed). false = call the API.
VITE_USE_MOCKS=true

# Development only (npm run dev), not part of the build: forward /api to a locally running
# API, e.g. http://127.0.0.1:8000. Leave empty when using mocks.
DEV_API_PROXY=

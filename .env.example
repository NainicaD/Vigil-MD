# Copy to .env and fill in. Never commit .env.

# Linux/WSL: output of `id -u`, so containers can write to the repo (data/, logs/)
AIRFLOW_UID=1000

# Optional. Encrypts connection passwords stored in the DB (blank = unencrypted).
# Set it before adding real connections. Generate with:
#   python3 -c 'import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())'
FERNET_KEY=

# Optional: web UI login (defaults: airflow / airflow)
# _AIRFLOW_WWW_USER_USERNAME=airflow
# _AIRFLOW_WWW_USER_PASSWORD=airflow

# Extra packages installed in every Airflow container at startup. Great Expectations
# and sqlalchemy-bigquery are needed by the validate step (scripts/validation/).
# After changing this line, run `docker compose up -d` to recreate the containers.
_PIP_ADDITIONAL_REQUIREMENTS=apache-airflow-providers-smtp apache-airflow-providers-google pytest google-cloud-storage great_expectations==1.24.0 sqlalchemy-bigquery==1.17.3
